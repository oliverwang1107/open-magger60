# Local-only material. None of this is ever committed.

# Flash backups read from your own keyboard (contain the vendor bootloader and your settings)
/backup*/

# Built, flashable images
/images/

# Anything obtained from the keyboard vendor (installers, firmware images, web driver files)
/vendor/
/extracted/
*.zip

# Build output and caches
/build/
/firmware/build/
__pycache__/
node_modules/

# Ghidra project databases and analysis output (regenerated by ghidra/analyze_boot.sh)
ghidra/proj/
ghidra/out/
*.rep/
*.lock
*.lock~
.reva/

# Personal profile and helper scripts (re-applied after every flash)
/local/

# Bad Apple clip data and previews are somebody else's work (docs/BADAPPLE_NOTES.md section 7)
*.kman
badapple*.gif
badapple_data.c
badapple_data.h
/badapple/

# Local clips for the animation page (a video and its music are somebody else's work; see tools/make_local_clip.py)
/ui/local/
